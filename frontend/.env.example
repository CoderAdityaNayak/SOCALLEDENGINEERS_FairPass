# Copy to frontend/.env and fill in. Only VITE_* variables reach the browser,
# so never put private keys here.

VITE_API_URL=http://localhost:8080
VITE_RPC_URL=https://orchard.rpc.quai.network
VITE_CHAIN_ID=15000
VITE_EXPLORER_URL=https://orchard.quaiscan.io
VITE_TICKET_CONTRACT_ADDRESS=0x00

# Optional: Firebase web config (same project as backend/.env). With it, the event and resale pages
# update live from Firestore fairpass/live; without it they poll the API every 10 s.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
